# pages are implemented natively.
.lavish/*
!.lavish/screens/
.lavish/screens/*
!.lavish/screens/*.html
!.lavish/screens/meridian.css

# VSS source-material originals (web-optimized copies live in assets/img)
site_content/
bin/
